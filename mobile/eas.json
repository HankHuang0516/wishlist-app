{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "play-internal": {
      "distribution": "store",
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ios-validation": {
      "distribution": "store",
      "credentialsSource": "remote",
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://wishlist-app-production.up.railway.app/api"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  }
}
